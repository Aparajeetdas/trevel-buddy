# Travel Buddy Serverless Proxy Environment Variables
# The Flutter mobile & web clients contain NO API keys.
# The server key lives strictly on the proxy and is restricted in Google Cloud Console to:
#  1. Places API (New)
#  2. Routes API
#  3. Geocoding API

PORT=8080
GOOGLE_MAPS_SERVER_KEY=your_google_cloud_server_key_here
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Security & CORS: Comma-separated trusted origins (NO wildcards in production)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://127.0.0.1:3000,http://127.0.0.1:8080,https://travelbuddy.web.app

# Circuit Breaker Daily Hard Caps (prevents runaway cloud costs)
DAILY_CAP_SEARCH=10000
DAILY_CAP_ROUTE=5000
DAILY_CAP_AI=2000
