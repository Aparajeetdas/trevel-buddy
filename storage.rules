rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // 1. Evidence photos for price reports
    match /evidence_photos/{allPaths=**} {
      // Public read of verified evidence images
      allow read: if true;

      // Allow upload only of images, size strictly under 2 MB, no listing
      allow write: if request.auth != null &&
                      request.resource.size < 2 * 1024 * 1024 &&
                      request.resource.contentType.matches('image/(jpeg|webp|png)');
    }

    // Default deny all other paths and prohibit public listing
    match /{allPaths=**} {
      allow list: if false;
      allow read, write: if false;
    }
  }
}
